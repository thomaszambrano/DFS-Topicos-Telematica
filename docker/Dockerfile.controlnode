FROM golang:1.27-alpine AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -o /out/controlnode ./cmd/controlnode

FROM alpine:3.21

RUN adduser -D -u 10001 dfsha
COPY --from=build /out/controlnode /usr/local/bin/controlnode
USER dfsha

# 8080 es la API REST del cliente (RX-04); 9090 es el gRPC de los heartbeats (RX-03).
# Dos puertos distintos porque son dos protocolos y dos planos distintos.
EXPOSE 8080 9090
ENTRYPOINT ["/usr/local/bin/controlnode"]
